# InnoCore AI 环境配置示例文件
# 复制此文件为 .env 并修改相应的值

# ============================================
# LLM 配置
# ============================================
# OpenAI API 配置（如果使用 OpenAI）
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-3.5-turbo

# 阿里云灵积配置（如果使用 Qwen 系列模型，推荐）
# DASHSCOPE_API_KEY=your_dashscope_api_key
# LLM_MODEL=qwen-plus

# ModelScope 配置
# MODELSCOPE_API_KEY=your_modelscope_api_key
# LLM_MODEL=qwen/Qwen2.5-7B-Instruct

# 通用 LLM 配置
LLM_BASE_URL=${OPENAI_BASE_URL}
LLM_MODEL=${OPENAI_MODEL}

# Embedding 配置
EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=your_embedding_api_key
# EMBEDDING_PROVIDER=openai

# ============================================
# 数据库配置
# ============================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=innocore_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# ============================================
# Redis 配置
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=your_redis_password

# ============================================
# 向量数据库配置（qdrant 或 pgvector）
# ============================================
VECTOR_DB_TYPE=qdrant
VECTOR_COLLECTION_PREFIX=innocore

# Qdrant 配置（VECTOR_DB_TYPE=qdrant 时使用）
QDRANT_HOST=localhost
QDRANT_PORT=6333
# QDRANT_API_KEY=your_qdrant_api_key
# QDRANT_HTTPS=false

# pgvector 配置（VECTOR_DB_TYPE=pgvector 时使用）
# 默认复用上面的 POSTGRES_*；独立数据库可设置完整连接串。
# PGVECTOR_CONNECTION_STRING=postgresql://postgres:password@localhost:5432/innocore_ai

# Embedding 维度变化时默认拒绝启动，避免误删已有向量。
# 仅确认旧索引可以丢弃时才开启。
# VECTOR_DB_RECREATE_ON_DIMENSION_MISMATCH=false

# ============================================
# 应用配置
# ============================================
DEBUG=true
LOG_LEVEL=INFO

# ============================================
# 外部 API 配置（可选）
# ============================================
# CROSSREF_API_KEY=your_crossref_api_key
# GOOGLE_SCHOLAR_API_KEY=your_google_scholar_api_key
# SERPAPI_KEY=your_serpapi_key
